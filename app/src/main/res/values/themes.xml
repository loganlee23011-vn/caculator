<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Caculator" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/calc_background</item>
    </style>

    <style name="Theme.Caculator" parent="Base.Theme.Caculator" />

    <!-- Shared style for all calculator buttons to avoid repeating attributes -->
    <style name="CalcButton">
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
